# Required. PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/echo

# Required. Secret for JWT signing (use a long random string in production).
JWT_SECRET=your-secret-change-in-production

# Optional. Default: 7d
JWT_EXPIRES_IN=7d

# Required. OpenAI API key for chat (GPT-4.1)
OPENAI_API_KEY=sk-your-openai-api-key

# Optional. OpenAI model. Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Required. Google Cloud project ID
GOOGLE_PROJECT_ID=your-gcp-project-id

# Required. Path to Google Cloud service account JSON (for STT and TTS)
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json

# Required. Server port.
PORT=3000

# Optional. development | production | test. Default: development
NODE_ENV=development

# Optional. AI provider timeout in milliseconds. Default: 8000
AI_TIMEOUT_MS=8000

# Optional. Enable health analytics and AI context enhancement. Default: true
HEALTH_ANALYTICS_ENABLED=true

# Required. Cerebras API key for LLaMA chat provider
CEREBRAS_API_KEY=your-cerebras-api-key

# Optional. AI provider selection. Values: openai | llama. Default: openai
AI_PROVIDER=openai

# Required. ElevenLabs API key for voice synthesis (TTS)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Required. ElevenLabs voice ID to use
ELEVENLABS_VOICE_ID=your-voice-id

# Vosk STT Service Configuration
# Optional. Vosk service URL. Default: http://localhost:5001
VOSK_SERVICE_URL=http://localhost:5001

# Optional. Enable voice mode features. Default: true
VOICE_MODE_ENABLED=true

# Optional. Silence timeout for speech detection in milliseconds. Default: 1200
VOICE_SILENCE_TIMEOUT=1200
